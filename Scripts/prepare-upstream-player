#!/bin/sh
set -eu

revision=735adf8859462b5beb47dbc96a51c75ded15c685
repository=https://github.com/bobsupra/NuvioTVOS.git
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
destination="$root/.upstream-player"
seed=
generate=false

usage() {
    cat <<'EOF'
Usage: Scripts/prepare-upstream-player [--checkout PATH] [--generate]

Prepare the pinned NuvioTVOS player with the Cinema app sources.
--checkout PATH   Copy an existing checkout at the pinned commit.
--generate        Generate the workspace with Tuist, without opening it.
                  Set NUVIO_TUIST_BIN to use a specific Tuist executable.
EOF
}

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --checkout)
            [ "$#" -ge 2 ] || die 'Missing path after --checkout.'
            seed=$(CDPATH= cd -- "$2" && pwd)
            shift 2
            ;;
        --generate) generate=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; die "Unknown option: $1" ;;
    esac
done

# Hold the same lock while inspecting the fingerprint, preparing, and publishing.
if [ "${NUVIO_PREPARE_LOCKED_ROOT:-}" != "$root" ]; then
    mkdir -p "$root/build"
    set --
    if [ -n "$seed" ]; then set -- --checkout "$seed"; fi
    if [ "$generate" = true ]; then set -- "$@" --generate; fi
    exec lockf -k "$root/build/.prepare-upstream-player.lock" \
        env NUVIO_PREPARE_LOCKED_ROOT="$root" "$root/Scripts/prepare-upstream-player" "$@"
fi

if [ -e "$destination" ] && [ ! -d "$destination/.git" ]; then
    die "Expected a Git checkout at $destination."
fi
if [ -n "$seed" ]; then
    [ "$(git -C "$seed" rev-parse HEAD)" = "$revision" ] || die "Seed must be at $revision."
fi

fingerprint=$(python3 - "$revision" "$root/Scripts/Patches" <<'PY'
import hashlib
import pathlib
import sys

revision, directory = sys.argv[1:]
digest = hashlib.sha256(revision.encode())
for patch in sorted(pathlib.Path(directory).glob("*.patch")):
    digest.update(b"\0" + patch.name.encode() + b"\0")
    digest.update(hashlib.sha256(patch.read_bytes()).digest())
print(digest.hexdigest())
PY
)

checkout="$destination"
staging=
previous=
cleanup() {
    if [ -n "$previous" ] && [ -d "$previous/.git" ] && [ ! -e "$destination" ]; then
        mv "$previous" "$destination" || printf 'Previous checkout is at %s\n' "$previous" >&2
    fi
    if [ -n "$staging" ]; then rm -rf "$staging"; fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ "$(cat "$destination/.git/nuviocinema-patches" 2>/dev/null || true)" != "$fingerprint" ] ||
    [ "$(git -C "$destination" rev-parse --verify HEAD 2>/dev/null || true)" != "$revision" ]; then
    staging=$(mktemp -d "$root/build/prepare-player.XXXXXX")
    checkout="$staging/checkout"
    reference="$seed"
    if [ -z "$reference" ] && git -C "$destination" cat-file -e "$revision^{commit}" 2>/dev/null; then
        reference="$destination"
    fi
    git init -q "$checkout"
    git -C "$checkout" remote add origin "$repository"
    if [ -n "$reference" ]; then
        # A sparse, shallow seed may lack objects outside the player paths. Copy
        # its object database instead of asking upload-pack to pack the whole tree.
        git_directory=$(git -C "$reference" rev-parse --path-format=absolute --git-common-dir)
        cp -cR "$git_directory/objects/." "$checkout/.git/objects/"
        if [ -f "$git_directory/shallow" ]; then cp "$git_directory/shallow" "$checkout/.git/shallow"; fi
        if [ "$(git -C "$reference" config --bool core.sparseCheckout || true)" = true ]; then
            git -C "$checkout" sparse-checkout set --sparse-index .github MPVKit ThirdParty Vendor tvosApp
        fi
    else
        git -C "$checkout" fetch --quiet --depth=1 --no-tags origin "$revision"
    fi
    git -C "$checkout" checkout --quiet --detach "$revision"

    if [ -f "$destination/tvosApp/Configurations/Signing.local.xcconfig" ]; then
        cp "$destination/tvosApp/Configurations/Signing.local.xcconfig" "$checkout/tvosApp/Configurations/"
    fi
    if [ -d "$destination/tvosApp/NuvioTV.xcworkspace" ]; then generate=true; fi
fi

for path in Tuist.swift tvosApp/Project.swift tvosApp/NuvioTV/Info.plist MPVKit/Package.swift \
            Vendor/AetherEngine/Package.swift Vendor/FFmpegBuild/Package.swift Vendor/LibTorrent/Package.swift; do
    [ -f "$checkout/$path" ] || die "Upstream checkout is missing $path."
done

if [ -n "$staging" ]; then
    for patch in "$root"/Scripts/Patches/*.patch; do
        git -C "$checkout" apply "$patch" || die "Could not apply $(basename "$patch") to the pinned player."
    done
fi

python3 - "$root" "$checkout" "$revision" <<'PY'
import pathlib
import plistlib
import re
import shutil
import subprocess
import sys

root, checkout = map(pathlib.Path, sys.argv[1:3])
revision = sys.argv[3]
app = checkout / "tvosApp/NuvioTV"


def upstream(path):
    return subprocess.check_output(["git", "-C", checkout, "show", f"{revision}:{path}"])


def replace_once(source, original, modified):
    if source.count(original) != 1:
        raise SystemExit(f"Expected exactly one occurrence of {original!r} in the pinned upstream source.")
    return source.replace(original, modified)


project = upstream("tvosApp/Project.swift").decode()
project = replace_once(project, 'let bundleID = "com.pyksel.nuviotvos"', 'let bundleID = "com.nuviocinema.app"')
project = replace_once(project, 'let marketingVersion = "3.5.1"', 'let marketingVersion = "0.1.6"')
project = replace_once(project, 'let projectVersion = "82"', 'let projectVersion = "1"')
project = replace_once(project, '    productName: "NuvioTV",', '    productName: "NuvioCinema",')
project = replace_once(project, '    "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) NUVIO_MPV_MEMORY_WATCHDOG",',
                        '    "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) NUVIO_MPV_MEMORY_WATCHDOG NUVIO_NETWORK_METRICS",')
project = replace_once(project, '    sources: ["NuvioTV/Sources/**/*.swift"],',
                        '    sources: ["NuvioTV/Sources/**/*.swift", "NuvioTV/CinemaSources/**/*.swift"],')
project = replace_once(project, '    resources: [\n        "NuvioTV/Images.xcassets",',
                        '    resources: [\n        "NuvioTV/Images.xcassets",\n'
                        '        .folderReference(path: "NuvioTV/CinemaResources/ThirdPartyNotices"),')
project = replace_once(project, '            "ENABLE_BITCODE": "NO",',
                        '            "ENABLE_BITCODE": "NO",\n'
                        '            "PRODUCT_MODULE_NAME": "NuvioTV",\n'
                        '            "EXCLUDED_ARCHS[sdk=appletvsimulator*]": "x86_64",\n'
                        '            "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) NUVIO_UPSTREAM_PLAYER",')
test_sources_start = project.index('    // These five files exist on disk')
test_sources_end = project.index('    dependencies:', test_sources_start)
project = project[:test_sources_start] + '    sources: ["CinemaTests/**/*.swift"],\n' + project[test_sources_end:]
ui_tests_start = project.index('// UI flows have separate data/setup requirements')
ui_tests_end = project.index('// MARK: - Project\n', ui_tests_start)
project = project[:ui_tests_start] + project[ui_tests_end:]
project = project.replace('"NuvioTVTests"', '"CinemaTests"')
project = replace_once(project, '    targets: [appTarget, topShelfTarget, unitTestsTarget, uiTestsTarget],',
                        '    targets: [appTarget, topShelfTarget, unitTestsTarget],')
project = replace_once(project,
    '''        .scheme(
            name: "NuvioTV-UI",
            shared: true,
            buildAction: .buildAction(targets: ["NuvioTV"]),
            testAction: .targets(
                ["NuvioTVUITests"],
                configuration: "Debug"
            ),
            runAction: .runAction(configuration: "Debug")
        ),
''', '')

entrypoint = "tvosApp/NuvioTV/Sources/NuvioTVApp.swift"
app_source = (checkout / entrypoint).read_text()
original_entry_marker = '@main\nstruct NuvioTVApp: App {'
cinema_entry_marker = 'struct NuvioTVApp: App {'
if original_entry_marker in app_source:
    app_source = replace_once(app_source, original_entry_marker, cinema_entry_marker)
elif app_source.count(cinema_entry_marker) != 1:
    raise SystemExit("Unexpected app entry point in the upstream checkout.")

info = plistlib.loads(upstream("tvosApp/NuvioTV/Info.plist"))
for key in ("NSBonjourServices", "BGTaskSchedulerPermittedIdentifiers"):
    info.pop(key, None)
info["CFBundleURLTypes"] = [{"CFBundleURLName": "com.nuviocinema.app.TopShelf", "CFBundleURLSchemes": ["nuvio-cinema"]}]
info["CFBundleDisplayName"] = "Nuvio Cinema"
info["UIBackgroundModes"] = ["audio"]
info["NSAppTransportSecurity"] = {"NSAllowsLocalNetworking": True}

source_overlay = app / "CinemaSources"
resource_overlay = app / "CinemaResources"
test_overlay = checkout / "tvosApp/CinemaTests"
for folder in (source_overlay, resource_overlay, test_overlay):
    if folder.exists():
        shutil.rmtree(folder)
    folder.mkdir()

source_root = root / "Sources"
legacy_playback = source_root / "Playback/Legacy"
for path in sorted(source_root.rglob("*.swift")):
    if path.is_relative_to(legacy_playback):
        continue
    destination = source_overlay / path.relative_to(source_root)
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, destination)

for path in sorted((root / "Tests").rglob("*.swift")):
    destination = test_overlay / path.relative_to(root / "Tests")
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, destination)

icon = app / "Images.xcassets/AppIcon.brandassets"
for stack in (root / "Resources/AppIcon.brandassets").glob("*.imagestack"):
    destination = icon / stack.name
    if destination.exists():
        shutil.rmtree(destination)
    shutil.copytree(stack, destination)

top_shelf_feed_path = "tvosApp/NuvioTV/Sources/Core/TopShelf/TopShelfFeed.swift"
top_shelf_feed = upstream(top_shelf_feed_path).decode()
top_shelf_feed = replace_once(top_shelf_feed, "import Foundation\n", "import Foundation\nimport OSLog\n")
top_shelf_feed = replace_once(top_shelf_feed, 'components.scheme = "nuvio-tv"', 'components.scheme = "nuvio-cinema"')
top_shelf_feed = replace_once(top_shelf_feed, '''        + topShelfProvisioningProfileGroupIdentifiers(at: appBundleURL)
''', '''        + (topShelfProvisioningProfileGroupIdentifiers(at: appBundleURL) ?? [])
''')
top_shelf_feed = replace_once(top_shelf_feed, '''private func topShelfProvisioningProfileGroupIdentifiers(at appBundleURL: URL) -> [String] {
    let profileURL = appBundleURL.appendingPathComponent("embedded.mobileprovision")
''', '''// A missing or unreadable profile is distinct from a profile that permits no App Groups.
func topShelfProvisioningProfileGroupIdentifiers(at bundleURL: URL) -> [String]? {
    let profileURL = bundleURL.appendingPathComponent("embedded.mobileprovision")
''')
top_shelf_feed = replace_once(top_shelf_feed, '''          ) else {
        return []
    }

    let plistData = profileData.subdata(in: xmlStart.lowerBound..<plistEnd.upperBound)
''', '''          ) else {
        return nil
    }

    let plistData = profileData.subdata(in: xmlStart.lowerBound..<plistEnd.upperBound)
''')
top_shelf_feed = replace_once(top_shelf_feed, '''    let profile = plistObject as? [String: Any],
    let entitlements = profile["Entitlements"] as? [String: Any],
    let groupIDs = entitlements["com.apple.security.application-groups"] as? [String] else {
        return []
    }
    return groupIDs
''', '''    let profile = plistObject as? [String: Any] else {
        return nil
    }
    let entitlements = profile["Entitlements"] as? [String: Any]
    return entitlements?["com.apple.security.application-groups"] as? [String] ?? []
''')
top_shelf_feed = replace_once(top_shelf_feed, '''    /// Mirrors every Home catalog row; Settings chooses which the shelf shows.
''', '''    static let homeFeaturedRowID = "home-featured"

    static var hasHomeFeaturedFeed: Bool {
        read(.catalog)?.catalogRows.contains { $0.id == homeFeaturedRowID && !$0.entries.isEmpty } == true
    }

    static func writeHomeFeatured(_ entries: [TopShelfEntry], title: String) {
        guard !entries.isEmpty else { return }
        guard isAvailable else {
            Logger(subsystem: "com.nuviocinema.app", category: "TopShelf")
                .error("Cannot publish Top Shelf. App group \\(topShelfAppGroupID, privacy: .public) is unavailable.")
            return
        }
        guard let coordinator = writeCoordinators[.catalog] else { return }
        let generation = coordinator.beginWrite()
        let row = TopShelfFeedRow(id: homeFeaturedRowID, title: title, entries: entries.map(decorated))
        let feed = TopShelfFeed(entries: [], rows: [row])
        var saved = false
        guard coordinator.commitIfCurrent(generation, commit: {
            saved = writeFeed(feed, section: .catalog)
        }), saved else { return }
        notifyTopShelfContentChanged()
        refreshArtwork()
    }

    /// Mirrors every Home catalog row; Settings chooses which the shelf shows.
''')
top_shelf_feed = replace_once(top_shelf_feed, '''    private static func writeFeed(_ feed: TopShelfFeed, section: TopShelfSection) {
        guard let url = feedFileURL(for: section),
              let data = try? JSONEncoder().encode(feed) else { return }
        TopShelfArtworkPruner.withFeedLock {
            try? data.write(to: url, options: .atomic)
        }
    }
''', '''    @discardableResult
    private static func writeFeed(_ feed: TopShelfFeed, section: TopShelfSection) -> Bool {
        guard let url = feedFileURL(for: section) else { return false }
        var saved = false
        TopShelfArtworkPruner.withFeedLock {
            do {
                let data = try JSONEncoder().encode(feed)
                try data.write(to: url, options: .atomic)
                saved = true
            } catch {
                Logger(subsystem: "com.nuviocinema.app", category: "TopShelf")
                    .error("Cannot write Top Shelf feed: \\(error.localizedDescription, privacy: .private)")
            }
        }
        return saved
    }
''')
top_shelf_layout_path = "tvosApp/NuvioTV/Sources/Core/TopShelf/TopShelfLayout.swift"
top_shelf_layout = upstream(top_shelf_layout_path).decode()
top_shelf_layout = replace_once(top_shelf_layout, '''    public static let `default` = TopShelfConfiguration(style: .featuredCards)
''', '''    public static let `default` = TopShelfConfiguration(style: .featuredCards)

    static let homeFeatured = TopShelfConfiguration(
        style: .carouselDetails, includesContinueWatching: false, includesUpNext: false,
        includesToday: false, includesLibrary: false, catalogRowIDs: [TopShelfFeedStore.homeFeaturedRowID],
        playsTrailers: false
    )
''')
top_shelf_provider_path = "tvosApp/TopShelf/TopShelfContentProvider.swift"
top_shelf_provider = upstream(top_shelf_provider_path).decode()
top_shelf_provider = replace_once(top_shelf_provider, '''        let configuration = TopShelfConfigurationStore.load()
        let rows = TopShelfComposer.rows(configuration: configuration) { TopShelfFeedStore.read($0) }
''', '''        let configuration = TopShelfConfiguration.homeFeatured
        let featuredRowID = "catalog:\\(TopShelfFeedStore.homeFeaturedRowID)"
        let rows = TopShelfComposer.rows(configuration: configuration) { TopShelfFeedStore.read($0) }
            .filter { $0.id == featuredRowID }
''')
top_shelf_provider = replace_once(top_shelf_provider, '''        // One button, Play: it resumes what can be resumed (Continue Watching,
        // Up Next) and opens the details page of everything else. A second
        // button (More Info) appears only with a display action.
        if let play = entry.deepLinkURL {
            item.playAction = TVTopShelfAction(url: play)
        }
''', '''        // The featured titles link to their detail pages.
        if let details = entry.detailsURL {
            item.displayAction = TVTopShelfAction(url: details)
        }
''')
catalog_models_path = "tvosApp/NuvioTV/Sources/Models/CatalogModels.swift"
catalog_models = (checkout / catalog_models_path).read_text()
original_top_shelf_writer = '''    static func writeTopShelfFeed() {
        guard TopShelfFeedStore.isAvailable else { return }
        topShelfSnapshotLock.lock()
        defer { topShelfSnapshotLock.unlock() }
        guard TraktSettingsStore.watchProgressSource == .nuvioSync else { return }
        writeTopShelfFeedLocked(from: items())
    }
'''
cinema_top_shelf_writer = '''    static func writeTopShelfFeed() {
        #if !NUVIO_UPSTREAM_PLAYER
        guard TopShelfFeedStore.isAvailable else { return }
        topShelfSnapshotLock.lock()
        defer { topShelfSnapshotLock.unlock() }
        guard TraktSettingsStore.watchProgressSource == .nuvioSync else { return }
        writeTopShelfFeedLocked(from: items())
        #endif
    }
'''
if cinema_top_shelf_writer not in catalog_models:
    catalog_models = replace_once(catalog_models, original_top_shelf_writer, cinema_top_shelf_writer)
for path in ("tvosApp/NuvioTV/NuvioTV.entitlements", "tvosApp/TopShelf/TopShelf.entitlements"):
    entitlements = {"com.apple.security.application-groups": ["group.com.nuviocinema.app"]}
    (checkout / path).write_bytes(plistlib.dumps(entitlements))
top_shelf_info_path = checkout / "tvosApp/TopShelf/Info.plist"
top_shelf_info = plistlib.loads(upstream("tvosApp/TopShelf/Info.plist"))
top_shelf_info["CFBundleDisplayName"] = "Nuvio Cinema Top Shelf"
top_shelf_info_path.write_bytes(plistlib.dumps(top_shelf_info))

notices = resource_overlay / "ThirdPartyNotices"
notices.mkdir()
for name in ("Anime4K-MIT.txt", "LibDovi-MIT.txt", "dovi_tool-MIT.txt"):
    shutil.copy2(root / "Resources/ThirdPartyNotices" / name, notices / name)
(notices / "NuvioTVOS-GPL-3.0.txt").write_bytes(upstream("LICENSE"))
(notices / "AetherEngine-LICENSE.txt").write_bytes(upstream("Vendor/AetherEngine/LICENSE"))
(notices / "MPVKit-LICENSE.txt").write_bytes(upstream("MPVKit/LICENSE"))
ffmpeg = checkout / "Vendor/FFmpegBuild"
shutil.copytree(ffmpeg / "LICENSES", notices / "FFmpegBuild")
shutil.copy2(ffmpeg / "LICENSE", notices / "FFmpegBuild" / "LICENSE.txt")
shutil.copy2(ffmpeg / "BUILD-INFO.txt", notices / "FFmpegBuild" / "BUILD-INFO.txt")
(notices / "NuvioTVOS-SOURCE.txt").write_text(
    f"This build incorporates NuvioTVOS at {revision}, licensed under GNU GPL v3.\n"
    f"Upstream source: https://github.com/bobsupra/NuvioTVOS/tree/{revision}\n"
    "The Cinema integration and project-generation script form part of the combined source.\n"
    "Include them and the required notices when distributing this build.\n\n"
    "AetherEngine 7.61.0, vendored by NuvioTVOS:\n"
    f"https://github.com/bobsupra/NuvioTVOS/tree/{revision}/Vendor/AetherEngine\n"
    "The accompanying FFmpegBuild notice directory includes its exact build record and license texts.\n"
    f"https://github.com/bobsupra/NuvioTVOS/tree/{revision}/Vendor/FFmpegBuild\n\n"
    "MPVKit (LGPL product), using the 0.41.0-n8.1.2 binary release:\n"
    f"https://github.com/bobsupra/NuvioTVOS/tree/{revision}/MPVKit\n"
    "https://github.com/mpvkit/MPVKit/tree/0.41.0-n8.1.2\n\n"
    "LibDovi 2.2.0 includes the dolby_vision 3.4.0 crate, under MIT.\n"
    "https://github.com/superuser404notfound/LibDovi/tree/2.2.0\n"
    "https://github.com/quietvoid/dovi_tool/tree/libdovi-3.4.0\n\n"
    "Anime4K line-art scaler kernels, copyright 2019–2021 bloc97, under MIT.\n"
    "https://github.com/bloc97/Anime4K/tree/7684e9586f8dcc738af08a1cdceb024cc184f426\n"
)

(checkout / "tvosApp/Project.swift").write_text(project)
(checkout / entrypoint).write_text(app_source)
(checkout / top_shelf_feed_path).write_text(top_shelf_feed)
(checkout / top_shelf_layout_path).write_text(top_shelf_layout)
(checkout / top_shelf_provider_path).write_text(top_shelf_provider)
(checkout / catalog_models_path).write_text(catalog_models)
(app / "Info.plist").write_bytes(plistlib.dumps(info))
PY

if [ "$generate" = true ]; then
    tuist_bin=${NUVIO_TUIST_BIN:-tuist}
    command -v "$tuist_bin" >/dev/null || die "Install Tuist or set NUVIO_TUIST_BIN to its executable."
    "$tuist_bin" generate --path "$checkout/tvosApp" --no-open --cache-profile none
fi

workspace="$checkout/tvosApp/NuvioTV.xcworkspace"
lock_dir="$workspace/xcshareddata/swiftpm"
lock="$lock_dir/Package.resolved"
if [ -d "$workspace" ] && [ -f "$checkout/tvosApp/.package.resolved" ]; then
    if [ -L "$lock" ]; then rm "$lock"; fi
    if [ ! -e "$lock" ]; then
        mkdir -p "$lock_dir"
        cp "$checkout/tvosApp/.package.resolved" "$lock"
    fi
fi

if [ -n "$staging" ]; then
    printf '%s\n' "$fingerprint" > "$checkout/.git/nuviocinema-patches"
    if [ -d "$destination/.git" ]; then
        previous=$(mktemp -d "$root/build/upstream-player-previous.XXXXXX")
        rmdir "$previous"
        mv "$destination" "$previous"
    fi
    mv "$checkout" "$destination"
    if [ -n "$previous" ]; then printf 'Previous player checkout saved to %s\n' "$previous" >&2; fi
fi

printf '%s\n' "$destination/tvosApp/NuvioTV.xcworkspace"
