+    // Capture the digit alone. Unicode letter and number boundaries keep identifiers and
+    // non-Latin words intact. A time such as "1 am" has no first-person predicate here.
+    private static let pronounContext = try! NSRegularExpression(pattern: #"""
+        (?<![\p{L}\p{M}\p{N}_])(1)(?=['’](?:m|d|ll|ve)\b)
+        |(?:^|[.!?;:—–]\h*|\b(?:if|because|that|when|but|though|unless)\h+)[\h"“‘(\[–—-]*
+            (1)\b(?=\h+(?:
+                am\h+(?:sorry|sure|ready|glad|afraid|fine|okay|going|trying|leaving|being)
+                |am\h+not\h+(?:sure|ready|going|trying|interested|afraid|here|the|a)
+                |(?:think|know|believe|hope|thought|remember)\h+(?:that|you|it|we|they|he|she|this|what|where|why|so|i)
+                |(?:want|need|have|tried)\h+to
+                |(?:don|didn|can|won|wouldn|couldn|shouldn|haven|wasn)['’]t
+            )\b)
+        |\b(?:can|could|may|should|would|do|did|have|was)\h+(1)\b
+            (?=\h+(?:be|do|go|see|have|help|take|come|try|tell|get|make|say|ask|know|hear|call|leave)\b)
+        """#, options: [.caseInsensitive, .allowCommentsAndWhitespace])
+
+    // A wider set of ordinary verbs requires an alternate Vision reading with the same
+    // surrounding text. Nouns and ambiguous clock times stay outside the candidate set.
+    private static let alternatePronounContext = try! NSRegularExpression(pattern: #"""
+        (?:^|[.!?;:—–]\h*|\b(?:if|because|that|when|but|though|unless)\h+)[\h"“‘(\[–—-]*
+        (1)\b(?=\h+(?:am\h+(?:here|so|too|very|not)
+            |(?:can|could|will|would|should|must|might)\h+(?:be|do|go|see|have|help|take|come|try|tell|get|make)
+            |(?:saw|said|told|heard|felt|knew|forgot|found|lost|meant|went|came|got|gave|took|
+                asked|made|remembered|was|have|had|like|love|hate|want|need)\h+\p{L}+)\b)
+        """#, options: [.caseInsensitive, .allowCommentsAndWhitespace])
+
+    /// Vision sometimes returns 1 for the English I. Use clear syntax on tagged English tracks,
+    /// and require a near-ranked candidate differing only at the pronoun for an untagged track
+    /// or a less certain context. No recognized digits elsewhere in the line are substituted.
+    nonisolated static func correctEnglishPronoun(
+        in text: String,
+        language: String?,
+        confidence: Float,
+        alternatives: () -> [(String, Float)]
+    ) -> String {
+        guard (language == "en" || language == nil), text.contains("1") else { return text }
+        let range = NSRange(text.startIndex..., in: text)
+        func digitPositions(_ pattern: NSRegularExpression) -> Set<Int> {
+            Set(pattern.matches(in: text, range: range).flatMap { match in
+                (1..<match.numberOfRanges).map { match.range(at: $0).location }.filter { $0 != NSNotFound }
+            })
         }
+        let clear = digitPositions(pronounContext)
+        var positions = language == "en" ? clear : []
+        let possible = clear.union(digitPositions(alternatePronounContext))
+        guard !possible.isEmpty else { return text }
+
+        let original = Array(text.utf16)
+        if !possible.isSubset(of: positions) {
+            let minimumConfidence: Float = language == nil ? 0.65 : 0.50
+            for (alternative, score) in alternatives()
+                where score >= minimumConfidence && confidence - score <= 0.08 && alternative.utf16.count == original.count {
+                let differences = zip(original, alternative.utf16).enumerated().filter { $0.element.0 != $0.element.1 }
+                guard !differences.isEmpty, differences.allSatisfy({ offset, pair in
+                    pair.0 == 0x31 && pair.1 == 0x49 && possible.contains(offset)
+                }) else { continue }
+                positions.formUnion(differences.map(\.offset))
+                break
+            }
+        }
+
+        guard !positions.isEmpty else { return text }
+        let corrected = NSMutableString(string: text)
+        for position in positions { corrected.replaceCharacters(in: NSRange(location: position, length: 1), with: "I") }
+        return corrected as String
     }
 
