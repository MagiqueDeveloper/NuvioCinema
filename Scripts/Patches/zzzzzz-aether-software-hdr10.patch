index 0000000..ea5fdad
--- /dev/null
+++ b/Vendor/AetherEngine/Tests/AetherEngineTests/FormatDescriptionFollowsHDR10MetadataTests.swift
@@ -0,0 +1,58 @@
+import Foundation
+import Testing
+import CoreMedia
+import CoreVideo
+@testable import AetherEngine
+
+/// AE#957: the renderer reuses its format description while the frames look the same, and the
+/// description snapshots the frame's HDR10 static metadata. So a change of that metadata at the same
+/// size and colour (a stream whose first frames carry none, or values that change) must make a new
+/// description, or the display layer keeps seeing the first frame's values.
+@Suite("Format description follows HDR10 static metadata")
+struct FormatDescriptionFollowsHDR10MetadataTests {
+
+    private func frame(cll: [UInt8]?) throws -> CVPixelBuffer {
+        var pb: CVPixelBuffer?
+        CVPixelBufferCreate(kCFAllocatorDefault, 64, 36, kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange,
+                            [kCVPixelBufferIOSurfacePropertiesKey: NSDictionary()] as NSDictionary, &pb)
+        let buffer = try #require(pb)
+        CVBufferSetAttachment(buffer, kCVImageBufferColorPrimariesKey, kCVImageBufferColorPrimaries_ITU_R_2020,
+                              .shouldPropagate)
+        CVBufferSetAttachment(buffer, kCVImageBufferTransferFunctionKey,
+                              kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ, .shouldPropagate)
+        CVBufferSetAttachment(buffer, kCVImageBufferYCbCrMatrixKey, kCVImageBufferYCbCrMatrix_ITU_R_2020,
+                              .shouldPropagate)
+        if let cll {
+            CVBufferSetAttachment(buffer, kCVImageBufferContentLightLevelInfoKey, Data(cll) as CFData,
+                                  .shouldPropagate)
+        }
+        return buffer
+    }
+
+    private func cll(_ sample: CMSampleBuffer) -> Data? {
+        guard let desc = CMSampleBufferGetFormatDescription(sample) else { return nil }
+        return CMFormatDescriptionGetExtension(
+            desc, extensionKey: kCMFormatDescriptionExtension_ContentLightLevelInfo) as? Data
+    }
+
+    @Test
+    @MainActor
+    func issue957AChangedContentLightLevelMakesANewDescription() throws {
+        let renderer = SampleBufferRenderer()
+        let none = try #require(renderer.createSampleBuffer(from: frame(cll: nil), pts: CMTime(value: 0, timescale: 24)))
+        #expect(cll(none) == nil)
+
+        let a = try #require(renderer.createSampleBuffer(from: frame(cll: [0x01, 0x59, 0x00, 0x7B]),
+                                                         pts: CMTime(value: 1, timescale: 24)))
+        #expect(cll(a) == Data([0x01, 0x59, 0x00, 0x7B]))
+
+        let b = try #require(renderer.createSampleBuffer(from: frame(cll: [0x0F, 0xA0, 0x03, 0xE8]),
+                                                         pts: CMTime(value: 2, timescale: 24)))
+        #expect(cll(b) == Data([0x0F, 0xA0, 0x03, 0xE8]))
+
+        // The same values again reuse the description: the cache still works.
+        let again = try #require(renderer.createSampleBuffer(from: frame(cll: [0x0F, 0xA0, 0x03, 0xE8]),
+                                                             pts: CMTime(value: 3, timescale: 24)))
+        #expect(CMSampleBufferGetFormatDescription(again) === CMSampleBufferGetFormatDescription(b))
+    }
+}
diff --git a/Vendor/AetherEngine/Tests/AetherEngineTests/HDR10MetadataFromAV1AndDecodedFramesTests.swift b/Vendor/AetherEngine/Tests/AetherEngineTests/HDR10MetadataFromAV1AndDecodedFramesTests.swift
new file mode 100644
index 0000000..3e2768a
--- /dev/null
+++ b/Vendor/AetherEngine/Tests/AetherEngineTests/HDR10MetadataFromAV1AndDecodedFramesTests.swift
@@ -0,0 +1,115 @@
+import Foundation
+import CoreVideo
+import AetherLibavutil
+import Testing
+@testable import AetherEngine
+
+/// AE#957: HDR10 static metadata on the software path's other routes. Hardware AV1 (VideoToolbox) reads it
+/// from the stream's metadata OBUs; the libavcodec decoder (dav1d AV1, VP9, H.264 High 10, HEVC Rext) reads it
+/// from each decoded frame's side data. Both give Core Video's byte layout, the one HEVC's SEI already has.
+@Suite("HDR10 metadata from AV1 OBUs and decoded frames (AE#957)")
+struct HDR10MetadataFromAV1AndDecodedFramesTests {
+
+    private static let clip = HDR10StaticMetadata(maxCLL: 1000, maxFALL: 400, masteringPeakNits: 1000,
+                                                  masteringMinNits: 0.005)
+    private static let expected = HDR10StaticMetadataSEI.Values(
+        masteringDisplay: clip.masteringDisplayColorVolume, contentLightLevel: clip.contentLightLevel)
+
+    /// BT.2020 red, green, blue, then D65, as x, y pairs.
+    private static let chromaticities: [Double] = [0.708, 0.292, 0.170, 0.797, 0.131, 0.046, 0.3127, 0.3290]
+
+    private static func bigEndian(_ value: UInt32, bytes: Int) -> [UInt8] {
+        (0 ..< bytes).reversed().map { UInt8((value >> (8 * UInt32($0))) & 0xFF) }
+    }
+
+    /// A metadata OBU with its size, then the trailing bits.
+    private static func metadataOBU(type: UInt8, _ body: [UInt8]) -> [UInt8] {
+        let payload = [type] + body + [0x80]
+        return [5 << 3 | 2, UInt8(payload.count)] + payload
+    }
+
+    private static var cllOBU: [UInt8] { metadataOBU(type: 1, bigEndian(1000, bytes: 2) + bigEndian(400, bytes: 2)) }
+
+    private static var mdcvOBU: [UInt8] {
+        var body: [UInt8] = []
+        for value in chromaticities { body += bigEndian(UInt32((value * 65_536).rounded()), bytes: 2) }
+        body += bigEndian(UInt32(1000 * 256), bytes: 4) // 24.8 fixed point
+        body += bigEndian(UInt32((0.005 * 16_384).rounded()), bytes: 4) // 18.14 fixed point
+        return metadataOBU(type: 2, body)
+    }
+
+    private static let temporalDelimiter: [UInt8] = [2 << 3 | 2, 0]
+    private static let frameOBU: [UInt8] = [6 << 3 | 2, 3, 0x10, 0x20, 0x30]
+
+    private static func scan(_ bytes: [UInt8]) -> HDR10StaticMetadataSEI.Values {
+        bytes.withUnsafeBufferPointer { HDR10StaticMetadataSEI.scanAV1($0.baseAddress!, size: $0.count) }
+    }
+
+    @Test func issue957AV1MetadataOBUsGiveCoreVideosLayout() {
+        let found = Self.scan(Self.temporalDelimiter + Self.cllOBU + Self.mdcvOBU + Self.frameOBU)
+        #expect(found == Self.expected)
+    }
+
+    @Test func issue957AV1ConfigRecordOBUsAreRead() {
+        let record: [UInt8] = [0x81, 0x0C, 0x00, 0x00] + Self.mdcvOBU + Self.cllOBU
+        let found = record.withUnsafeBufferPointer {
+            HDR10StaticMetadataSEI.scanAV1ConfigRecord($0.baseAddress!, size: $0.count)
+        }
+        #expect(found == Self.expected)
+        let notARecord = [UInt8](repeating: 0, count: 8)
+        let none = notARecord.withUnsafeBufferPointer {
+            HDR10StaticMetadataSEI.scanAV1ConfigRecord($0.baseAddress!, size: $0.count)
+        }
+        #expect(none == .none)
+    }
+
+    @Test func issue957AMalformedAV1TemporalUnitKeepsWhatWasRead() {
+        // An OBU that declares more bytes than the packet holds ends the walk.
+        let overrun = Self.scan(Self.cllOBU + [5 << 3 | 2, 0x7F, 0x02, 0x00])
+        #expect(overrun == HDR10StaticMetadataSEI.Values(contentLightLevel: Self.expected.contentLightLevel))
+        // A short MDCV and a set forbidden bit yield nothing.
+        #expect(Self.scan(Self.metadataOBU(type: 2, [0x01, 0x02])) == .none)
+        #expect(Self.scan([0x80] + Self.cllOBU) == .none)
+    }
+
+    @Test func issue957ADecodedFramesSideDataGivesCoreVideosLayout() throws {
+        var frame: UnsafeMutablePointer<AVFrame>? = av_frame_alloc()
+        defer { av_frame_free(&frame) }
+        let decoded = try #require(frame)
+        #expect(HDR10StaticMetadataSEI.fromFrameSideData(decoded) == .none)
+
+        // libdav1d's units: 0.16 fixed point chromaticity, 24.8 and 18.14 fixed point luminance.
+        let mastering = try #require(av_mastering_display_metadata_create_side_data(decoded))
+        func q(_ value: Double, _ den: Int32) -> AVRational {
+            AVRational(num: Int32((value * Double(den)).rounded()), den: den)
+        }
+        let c = Self.chromaticities.map { q($0, 1 << 16) }
+        mastering.pointee.display_primaries = ((c[0], c[1]), (c[2], c[3]), (c[4], c[5]))
+        mastering.pointee.white_point = (c[6], c[7])
+        mastering.pointee.max_luminance = q(1000, 1 << 8)
+        mastering.pointee.min_luminance = q(0.005, 1 << 14)
+        mastering.pointee.has_primaries = 1
+        mastering.pointee.has_luminance = 1
+        let lightLevel = try #require(av_content_light_metadata_create_side_data(decoded))
+        lightLevel.pointee.MaxCLL = 1000
+        lightLevel.pointee.MaxFALL = 400
+
+        #expect(HDR10StaticMetadataSEI.fromFrameSideData(decoded) == Self.expected)
+    }
+
+    @Test func issue957TheSoftwareDecoderSetsAndClearsTheHDR10Keys() throws {
+        var buffer: CVPixelBuffer?
+        CVPixelBufferCreate(kCFAllocatorDefault, 16, 16, kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange, nil, &buffer)
+        let pb = try #require(buffer)
+        SoftwareVideoDecoder.setHDR10(Self.expected, on: pb)
+        let mastering = CVBufferCopyAttachment(pb, kCVImageBufferMasteringDisplayColorVolumeKey, nil) as? Data
+        let lightLevel = CVBufferCopyAttachment(pb, kCVImageBufferContentLightLevelInfoKey, nil) as? Data
+        #expect(mastering == Self.expected.masteringDisplay)
+        #expect(lightLevel == Self.expected.contentLightLevel)
+
+        // A reused pool buffer for a frame with no values keeps none of the last frame's.
+        SoftwareVideoDecoder.setHDR10(.none, on: pb)
+        #expect(CVBufferCopyAttachment(pb, kCVImageBufferMasteringDisplayColorVolumeKey, nil) == nil)
+        #expect(CVBufferCopyAttachment(pb, kCVImageBufferContentLightLevelInfoKey, nil) == nil)
+    }
+}
diff --git a/Vendor/AetherEngine/Tests/AetherEngineTests/SoftwarePathCarriesStreamHDR10MetadataTests.swift b/Vendor/AetherEngine/Tests/AetherEngineTests/SoftwarePathCarriesStreamHDR10MetadataTests.swift
new file mode 100644
index 0000000..8842aed
--- /dev/null
+++ b/Vendor/AetherEngine/Tests/AetherEngineTests/SoftwarePathCarriesStreamHDR10MetadataTests.swift
@@ -0,0 +1,196 @@
+import Foundation
+import CoreVideo
+import AetherLibavcodec
+import AetherLibavutil
+import Testing
+@testable import AetherEngine
+
+/// AE#957: VideoToolbox attaches no HDR10 static metadata to the frames it decodes, so the software path
+/// sent HDR10 with none. The hardware decoder now finds the stream's values (container, `hvcC` or SEI)
+/// and the output normalizer attaches them to every frame.
+@Suite("Software path carries the stream's HDR10 metadata (AE#957)")
+struct SoftwarePathCarriesStreamHDR10MetadataTests {
+
+    /// A typical x265 HDR10 encode: BT.2020 at 1000 nit, minimum 0.005, MaxCLL 1000 / 400.
+    private static let clip = HDR10StaticMetadata(maxCLL: 1000, maxFALL: 400, masteringPeakNits: 1000,
+                                                  masteringMinNits: 0.005)
+
+    /// A prefix SEI NAL (no start code or length) with both messages, emulation prevention applied: the
+    /// minimum luminance (50 = 00 00 00 32) needs it, as in every real HDR10 stream.
+    private static func seiNAL(_ m: HDR10StaticMetadata = clip) -> [UInt8] {
+        var rbsp: [UInt8] = [137, 24] + [UInt8](m.masteringDisplayColorVolume)
+        rbsp += [144, 4] + [UInt8](m.contentLightLevel)
+        rbsp.append(0x80)
+        var escaped: [UInt8] = [39 << 1, 1]
+        var zeros = 0
+        for byte in rbsp {
+            if zeros >= 2, byte <= 3 { escaped.append(3); zeros = 0 }
+            escaped.append(byte)
+            zeros = byte == 0 ? zeros + 1 : 0
+        }
+        return escaped
+    }
+
+    private static func lengthPrefixed(_ nal: [UInt8], size: Int) -> [UInt8] {
+        (0 ..< size).reversed().map { UInt8((nal.count >> (8 * $0)) & 0xFF) } + nal
+    }
+
+    private func scan(_ bytes: [UInt8], framing: A53SEIParser.NALFraming) -> HDR10StaticMetadataSEI.Values {
+        bytes.withUnsafeBufferPointer {
+            HDR10StaticMetadataSEI.scan($0.baseAddress!, size: $0.count, codec: .hevc, framing: framing)
+        }
+    }
+
+    @Test func issue957TheSEIInAKeyFrameGivesCoreVideosBytes() {
+        let expected = HDR10StaticMetadataSEI.Values(
+            masteringDisplay: Self.clip.masteringDisplayColorVolume, contentLightLevel: Self.clip.contentLightLevel)
+        // An access unit: an AUD, the SEI, a slice.
+        let aud: [UInt8] = [35 << 1, 1, 0x50]
+        let slice: [UInt8] = [19 << 1, 1, 0xAF, 0x00, 0x11]
+        let annexB: [UInt8] = [0, 0, 0, 1] + aud + [0, 0, 1] + Self.seiNAL() + [0, 0, 1] + slice
+        let fromAnnexB = scan(annexB, framing: .annexB)
+        #expect(fromAnnexB == expected)
+        let mp4 = [aud, Self.seiNAL(), slice].flatMap { Self.lengthPrefixed($0, size: 4) }
+        let fromMP4 = scan(mp4, framing: .lengthPrefixed(size: 4))
+        #expect(fromMP4 == expected)
+    }
+
+    @Test func issue957APacketWithoutTheSEIGivesNothing() {
+        let slice: [UInt8] = [19 << 1, 1, 0xAF, 0x00, 0x11]
+        let fromSlice = scan(Self.lengthPrefixed(slice, size: 4), framing: .lengthPrefixed(size: 4))
+        #expect(fromSlice.isEmpty)
+        // A truncated message is skipped, not read past its end.
+        let cut = Array(Self.seiNAL().prefix(12))
+        let fromCut = scan(Self.lengthPrefixed(cut, size: 4), framing: .lengthPrefixed(size: 4))
+        #expect(fromCut.isEmpty)
+    }
+
+    @Test func issue957TheHvcCSEIArrayIsRead() {
+        let sei = Self.seiNAL()
+        var record = [UInt8](repeating: 0, count: 23)
+        record[0] = 1
+        record[22] = 2
+        let vps: [UInt8] = [32 << 1, 1, 0x0C]
+        let vpsArray: [UInt8] = [0x80 | 32, 0, 1, 0, UInt8(vps.count)]
+        let seiArray: [UInt8] = [39, 0, 1, UInt8(sei.count >> 8), UInt8(sei.count & 0xFF)]
+        record += vpsArray + vps
+        record += seiArray + sei
+        let found = record.withUnsafeBufferPointer {
+            HDR10StaticMetadataSEI.scanHEVCConfigRecord($0.baseAddress!, size: $0.count)
+        }
+        #expect(found.masteringDisplay == Self.clip.masteringDisplayColorVolume)
+        #expect(found.contentLightLevel == Self.clip.contentLightLevel)
+        // A record cut inside its arrays gives nothing rather than a guess.
+        let cut = Array(record.dropLast(10))
+        let fromCut = cut.withUnsafeBufferPointer {
+            HDR10StaticMetadataSEI.scanHEVCConfigRecord($0.baseAddress!, size: $0.count)
+        }
+        #expect(fromCut.isEmpty)
+    }
+
+    @Test func issue957TheContainersDeclarationMatchesTheSEIBytes() throws {
+        let codecpar = try #require(avcodec_parameters_alloc())
+        defer { var p: UnsafeMutablePointer<AVCodecParameters>? = codecpar; avcodec_parameters_free(&p) }
+        let mdcv = try #require(av_packet_side_data_new(
+            &codecpar.pointee.coded_side_data, &codecpar.pointee.nb_coded_side_data,
+            AV_PKT_DATA_MASTERING_DISPLAY_METADATA, MemoryLayout<AVMasteringDisplayMetadata>.size, 0))
+        try #require(mdcv.pointee.data).withMemoryRebound(to: AVMasteringDisplayMetadata.self, capacity: 1) {
+            func q(_ v: Int32) -> AVRational { AVRational(num: v, den: 50_000) }
+            // FFmpeg's order: red, green, blue.
+            $0.pointee.display_primaries = ((q(35400), q(14600)), (q(8500), q(39850)), (q(6550), q(2300)))
+            $0.pointee.white_point = (q(15635), q(16450))
+            $0.pointee.max_luminance = AVRational(num: 1000, den: 1)
+            $0.pointee.min_luminance = AVRational(num: 50, den: 10_000)
+            $0.pointee.has_primaries = 1
+            $0.pointee.has_luminance = 1
+        }
+        let cll = try #require(av_packet_side_data_new(
+            &codecpar.pointee.coded_side_data, &codecpar.pointee.nb_coded_side_data,
+            AV_PKT_DATA_CONTENT_LIGHT_LEVEL, MemoryLayout<AVContentLightMetadata>.size, 0))
+        try #require(cll.pointee.data).withMemoryRebound(to: AVContentLightMetadata.self, capacity: 1) {
+            $0.pointee.MaxCLL = 1000
+            $0.pointee.MaxFALL = 400
+        }
+        let found = HDR10StaticMetadataSEI.fromCodedSideData(codecpar)
+        #expect(found.masteringDisplay == Self.clip.masteringDisplayColorVolume)
+        #expect(found.contentLightLevel == Self.clip.contentLightLevel)
+    }
+
+    @Test func issue957AHalfFilledContainerVolumeIsNotUsed() {
+        var m = AVMasteringDisplayMetadata()
+        m.max_luminance = AVRational(num: 1000, den: 1)
+        m.has_luminance = 1
+        #expect(HDR10StaticMetadataSEI.masteringDisplay(m) == nil)
+    }
+
+    @Test func issue957TheNormalizerAttachesTheValuesToEveryFrame() throws {
+        let values = HDR10StaticMetadataSEI.Values(
+            masteringDisplay: Self.clip.masteringDisplayColorVolume, contentLightLevel: Self.clip.contentLightLevel)
+        let normalizer = VideoToolboxOutputMetadataNormalizer()
+        func frame() throws -> CVPixelBuffer {
+            var buffer: CVPixelBuffer?
+            CVPixelBufferCreate(kCFAllocatorDefault, 16, 16, kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange,
+                                [kCVPixelBufferIOSurfacePropertiesKey: NSDictionary()] as NSDictionary, &buffer)
+            return try #require(buffer)
+        }
+        func attached(_ b: CVPixelBuffer) -> [Data?] {
+            [CVBufferCopyAttachment(b, kCVImageBufferMasteringDisplayColorVolumeKey, nil) as? Data,
+             CVBufferCopyAttachment(b, kCVImageBufferContentLightLevelInfoKey, nil) as? Data]
+        }
+        let both: [Data?] = [values.masteringDisplay, values.contentLightLevel]
+        let neither: [Data?] = [nil, nil]
+        func normalize(_ b: CVPixelBuffer, modifiable: Bool) -> CVPixelBuffer {
+            normalizer.applyingOutputMetadata(to: b, isModifiable: modifiable, colorPrimaries: nil,
+                transferFunction: nil, yCbCrMatrix: nil, pixelAspectRatio: nil, hdr10: values)
+        }
+
+        // Decoder-owned (immutable) output: the values go on an owned copy, the original is untouched.
+        let owned = try frame()
+        let copy = normalize(owned, modifiable: false)
+        #expect(copy !== owned)
+        #expect(attached(owned) == neither)
+        #expect(attached(copy) == both)
+
+        // Modifiable output gets them in place; a frame that already carries them passes unchanged.
+        let modifiable = try frame()
+        #expect(normalize(modifiable, modifiable: true) === modifiable)
+        #expect(attached(modifiable) == both)
+        #expect(normalize(modifiable, modifiable: false) === modifiable)
+
+        // No values known: the frame is left as it is.
+        let plain = try frame()
+        let untouched = normalizer.applyingOutputMetadata(to: plain, isModifiable: false, colorPrimaries: nil,
+            transferFunction: nil, yCbCrMatrix: nil, pixelAspectRatio: nil)
+        #expect(untouched === plain)
+    }
+
+    /// A value the frame already carries is the decoder's own and stays: only a missing key is filled, and a
+    /// frame with both keys is not copied, whatever values they hold.
+    @Test func issue957AFrameThatCarriesItsOwnValuesKeepsThem() throws {
+        let values = HDR10StaticMetadataSEI.Values(
+            masteringDisplay: Self.clip.masteringDisplayColorVolume, contentLightLevel: Self.clip.contentLightLevel)
+        let own = HDR10StaticMetadata(maxCLL: 4000, maxFALL: 1000, masteringPeakNits: 4000,
+                                      masteringMinNits: 0.005).masteringDisplayColorVolume
+        var created: CVPixelBuffer?
+        CVPixelBufferCreate(kCFAllocatorDefault, 16, 16, kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange,
+                            [kCVPixelBufferIOSurfacePropertiesKey: NSDictionary()] as NSDictionary, &created)
+        let frame = try #require(created)
+        CVBufferSetAttachment(frame, kCVImageBufferMasteringDisplayColorVolumeKey, own as CFData, .shouldPropagate)
+        let normalizer = VideoToolboxOutputMetadataNormalizer()
+        func normalize(modifiable: Bool) -> CVPixelBuffer {
+            normalizer.applyingOutputMetadata(to: frame, isModifiable: modifiable, colorPrimaries: nil,
+                transferFunction: nil, yCbCrMatrix: nil, pixelAspectRatio: nil, hdr10: values)
+        }
+
+        let inPlace = normalize(modifiable: true)
+        let mastering = CVBufferCopyAttachment(frame, kCVImageBufferMasteringDisplayColorVolumeKey, nil) as? Data
+        let lightLevel = CVBufferCopyAttachment(frame, kCVImageBufferContentLightLevelInfoKey, nil) as? Data
+        #expect(inPlace === frame)
+        #expect(mastering == own)
+        #expect(lightLevel == Self.clip.contentLightLevel)
+
+        // Both keys present now: a decoder-owned frame passes as it is, no copy.
+        let owned = normalize(modifiable: false)
+        #expect(owned === frame)
+    }
+}
