+        staticHDR10KeyFramesLeft = staticHDR10.isComplete ? 0 : max(staticHDR10KeyFramesLeft - 1, 0)
+        let values = staticHDR10
+        let done = staticHDR10KeyFramesLeft == 0
+        staticHDR10Lock.unlock()
+        guard done else { return nil }
