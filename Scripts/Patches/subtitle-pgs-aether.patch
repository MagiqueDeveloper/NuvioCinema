+    nonisolated static func recognizeForPlayback(_ image: CGImage, trackLanguage: String?) async -> String? {
+        let language = recognitionLanguage(forTrackLanguage: trackLanguage)
+        return await playbackExecutor.run {
+            guard let flat = flattenedOntoBlack(image) else { return nil }
+            if let observations = recognize(flat, at: .fast, language: language, requireLanguageMatch: true) {
+                return assembleLines(observations)
+            }
