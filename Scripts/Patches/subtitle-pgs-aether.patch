+    @Test("fullscreen OCR preserves Vision's confidently ranked text")
+    func preservesConfidentReading() {
+        let dialogue: [(String, Float)] = [("-I need an explainer", 0.95), ("-1 need an explainer", 0.72)]
+        let number: [(String, Float)] = [("-1 dB", 0.95), ("-I dB", 0.72)]
+        #expect(SubtitleImageOCR.playbackReading(from: [(dialogue, 0.5)])?.acceptedText() == "-I need an explainer")
+        #expect(SubtitleImageOCR.playbackReading(from: [(number, 0.5)])?.acceptedText() == "-1 dB")
+    }
+
+    @Test("fullscreen OCR falls back to the bitmap for uncertain readings")
+    func rejectsUncertainReading() {
+        let ambiguous: [(String, Float)] = [("-1 need an explainer", 0.92), ("-I need an explainer", 0.89)]
+        let lowConfidence: [(String, Float)] = [("[beeping]", 0.40)]
+        let reading = SubtitleImageOCR.playbackReading(from: [(ambiguous, 0.5)])
+        #expect(reading?.acceptedText() == nil)
+        #expect(reading?.acceptedText(verifiedBy: reading) == nil)
+        #expect(SubtitleImageOCR.playbackReading(from: [(lowConfidence, 0.5)]) == nil)
+        #expect(SubtitleImageOCR.playbackReading(from: []) == nil)
+    }
+
+    @Test("fullscreen OCR verifies tied accurate readings across all caption lines")
+    func verifiesTiedReading() {
+        let question = "-So, are you two dating?"
+        let response = "-Oh, um, we-- I--"
+        let reading = SubtitleImageOCR.playbackReading(from: [
+            ([(response, 1), ("-Oh, um, we-- l--", 1)], 0.25),
+            ([(question, 1), ("-So, are you two dating.", 1)], 0.75)
+        ])
+        let verified = SubtitleImageOCR.playbackReading(from: [([(question, 1)], 0.75), ([(response, 1)], 0.25)])
+        let different = SubtitleImageOCR.playbackReading(from: [
+            ([(question, 1)], 0.75), ([("-Oh, um, we-- 1--", 1)], 0.25)
+        ])
+        let incomplete = SubtitleImageOCR.playbackReading(from: [([(question, 1)], 0.75)])
+        #expect(reading?.acceptedText(verifiedBy: verified) == "\(question)\n\(response)")
+        #expect(reading?.acceptedText(verifiedBy: different) == nil)
+        #expect(reading?.acceptedText(verifiedBy: incomplete) == nil)
+    }
