Restart a native session whose clock stalls with video buffered ahead

The wall-clock poll restarts AVPlayer when the playhead sits still for 2 s
with 2 s of contiguous video buffered, and skips a redundant 1x rate write
after load. The AE#1024 end-of-stream work this patch once carried is part of
the vendored AetherEngine 7.70.

diff --git a/Vendor/AetherEngine/Sources/AetherEngine/AetherEngine.swift b/Vendor/AetherEngine/Sources/AetherEngine/AetherEngine.swift
index dd39ae3172dea09a54cfb98e53489b8e73551dce..04b10cc05ebff1e7cf339f116c1df255d9f97362 100644
--- a/Vendor/AetherEngine/Sources/AetherEngine/AetherEngine.swift
+++ b/Vendor/AetherEngine/Sources/AetherEngine/AetherEngine.swift
@@ -6820,6 +6820,16 @@ public final class AetherEngine: ObservableObject {
         return nativeHost
     }
 
+    /// Called from the host's wall-clock poll, which also runs while media time is parked.
+    public func recoverBufferedVideoPlaybackIfStalled() {
+        #if os(tvOS)
+        let canRecover = !isLive && !isSeeking && !isAwaitingDisplaySwitch && !isBackgrounded
+            && !audioInterruptionActive && !pictureInPictureActive
+            && (state == .playing || state == .paused || state == .loading)
+        nativeHost?.recoverBufferedPlaybackIfStalled(eligible: canRecover)
+        #endif
+    }
+
     public func play() {
         recordTransportDuringRebuild(playing: true)
         EngineLog.emit("[AetherEngine] play() state=\(state)", category: .engine)
diff --git a/Vendor/AetherEngine/Sources/AetherEngine/Native/NativeAVPlayerHost.swift b/Vendor/AetherEngine/Sources/AetherEngine/Native/NativeAVPlayerHost.swift
