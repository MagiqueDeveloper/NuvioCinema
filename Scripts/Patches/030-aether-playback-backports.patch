@@ -335,6 +335,8 @@ final class NativeAVPlayerHost {
     private var pendingExternalMetadata: [AVMetadataItem] = []
     private var timeObserver: Any?
     private var videoFrameTask: Task<Void, Never>?
+    private var bufferedPlaybackSample: (position: Double, since: ContinuousClock.Instant)?
+    private var bufferedPlaybackRecoveryPosition: Double?
     private var diagnosticVideoOutput: AVPlayerItemVideoOutput?
     private var videoFrameProgress = VideoFrameProgress()
     private var videoFrameSampleAt: Double?
@@ -2194,6 +2196,37 @@ final class NativeAVPlayerHost {
             + "the nearest \(where_) (playhead \(head))" + status
     }
 
+    func recoverBufferedPlaybackIfStalled(eligible: Bool) {
+        #if os(tvOS)
+        let position = renderedTime
+        guard eligible, UIApplication.shared.applicationState == .active, playIntent, isReady,
+              hasPresentedVideo, failure == nil, !didReachEnd, !seekInFlight, !mountSeekPending,
+              !prematureEndRecoveryInFlight, !avPlayer.isExternalPlaybackActive,
+              playerLayer.superlayer != nil, position.isFinite,
+              Self.contiguousBufferedEnd(ranges: loadedVideoRanges, now: position) - position >= 2 else {
+            bufferedPlaybackSample = nil
+            return
+        }
+        if let recoveredAt = bufferedPlaybackRecoveryPosition {
+            guard abs(position - recoveredAt) >= 0.5 else { return }
+            bufferedPlaybackRecoveryPosition = nil
+        }
+        let now = ContinuousClock.now
+        guard let sample = bufferedPlaybackSample, abs(position - sample.position) < 0.05 else {
+            bufferedPlaybackSample = (position, now)
+            return
+        }
+        guard sample.since.duration(to: now) >= .seconds(2) else { return }
+        bufferedPlaybackRecoveryPosition = position
+        bufferedPlaybackSample = nil
+        EngineLog.emit("[NativeAVPlayerHost] Buffered playback clock stalled; restarting transport", category: .engine)
+        // Preserve the configured speed and reassert the host's play intent. There is no suspension
+        // point between the two calls where a viewer pause could be overridden.
+        avPlayer.pause()
+        play()
+        #endif
+    }
+
     func play() {
         // Set intent before play() so readyToPlay observer can re-assert if the replaceCurrentItem swap swallowed it.
         playIntent = true
