+    func testRemoteVODStartupWatchdogGraceRequiresContainerOpened() {
+        let request = PlaybackLoadRequest(videoURL: URL(string: "https://example.test/movie.mkv")!)
+        let cases: [(StartupCheckpoint, Bool)] = [
+            (.dispatched, false),
+            (.sourceOpened, false),
+            (.containerOpened, true),
+            (.streamsProbed, true)
+        ]
+
+        for (checkpoint, expected) in cases {
+            let progress = AetherStartupLoadCheckpointWitness(
+                ownerLoadGeneration: 8,
+                engineGenerationFloor: 14,
+                progressGeneration: 14,
+                checkpoint: checkpoint
+            )
+            func shouldGrant(alreadyGranted: Bool) -> Bool {
+                AetherStartupWatchdogGracePolicy.shouldGrantGrace(
+                    request: request,
+                    backend: .aether,
+                    loadGeneration: 8,
+                    dispatchedLoadGeneration: 8,
+                    progress: progress,
+                    graceAlreadyGranted: alreadyGranted
+                )
+            }
+            XCTAssertEqual(shouldGrant(alreadyGranted: false), expected)
+            XCTAssertFalse(shouldGrant(alreadyGranted: true))
+        }
     }
 
